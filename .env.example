# 聊天模型：必须支持 Tool Calling。
MODEL_PROVIDER=openai
MODEL_NAME=qwen-max

# 使用 OpenAI 兼容接口时填写；也可以改用服务商原生环境变量。
API_KEY=<替换成你自己的密钥>
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Docker 启动命令会显式监听 0.0.0.0:8000；main.py 不读取这两个值。
# HOST=127.0.0.1
# PORT=8000

# 当前代码把单轮流式超时硬编码为 90 秒，暂不读取此变量。
# STREAM_TIMEOUT_SECONDS=300

# 本地 Hugging Face Embedding。模型缓存和 Chroma 索引已在 Docker 构建阶段生成。
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Docker runtime 会自动设置 HF_HUB_OFFLINE=1 并读取镜像内模型缓存。

# JWT_SECRET_KEY 必须使用至少 32 字节的随机值，不要提交真实值。
JWT_SECRET_KEY=<替换成至少32字节的随机密钥>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 业务数据所在的 MySQL 库：需要事先建表并导入数据，表结构见 models.py。
# 本地运行通常使用 127.0.0.1；Docker 容器内应使用 host.docker.internal。
DATABASE_URL=mysql+pymysql://agent_app:ChangeMe@127.0.0.1:3306/agent_service?charset=utf8mb4

# LangGraph 会话检查点。Docker 运行时会改用持久化 Volume 中的绝对路径。
CHECKPOINT_DB=runtime/checkpoints.sqlite3

# Docker 运行时可覆盖向量库位置；本地通常不需要设置。
# VECTOR_STORE_DIR=vector_store
